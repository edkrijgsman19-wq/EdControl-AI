{
  "name": "edcontrol-ai-mobile",
  "version": "1.0.0",
  "description": "AI-powered building inspection platform for iOS & Android",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
