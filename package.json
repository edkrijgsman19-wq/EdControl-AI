    "expo-image-picker": "^14.3.0",
    "expo-file-system": "^16.0.5",
    "expo-sharing": "^12.0.1",
    "expo-status-bar": "^1.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.23.0"
  }
}
